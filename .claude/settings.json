{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-read.sh\"",
            "statusMessage": "Checking secret-store access policy"
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*|mcp__chrome-devtools__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-ai-leaks.py\"",
            "statusMessage": "Checking form text for AI leaks"
          }
        ]
      }
    ]
  }
}
